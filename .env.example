# Shopify headless store settings
SHOPIFY_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=your-storefront-access-token
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=your-client-id
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=your-client-secret
SHOPIFY_CLIENT_ID=your-admin-app-client-id
SHOPIFY_CLIENT_SECRET=your-admin-app-client-secret
SHOPIFY_WEBHOOK_SECRET=your-webhook-secret

# Stripe billing/webhooks
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# App
SECRET_KEY=change-this-to-a-random-secret
MASTER_ADMIN_EMAIL=shawn@shawnzyluxe.com,admin@shawnzyluxe.com
ENGINEER_EMAIL=engineer@shawnzyluxe.com
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
SITE_WALL_PASSWORD=your-portal-wall-password
TEMP_ACCOUNTS_PASSWORD=your-shared-temp-account-password

# Optional: set to any value to expose magic-link URLs in non-test environments
# DEBUG_MAGIC_LINK=1
