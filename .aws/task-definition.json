{
  "family": "vanta-coo-engine-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::112233445566:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::112233445566:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "vanta_coo_engine",
      "image": "112233445566.dkr.ecr.us-east-1.amazonaws.com/vanta-coo-engine:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "PYTHONUNBUFFERED",
          "value": "1"
        },
        {
          "name": "APP_ENVIRONMENT",
          "value": "production"
        }
      ],
      "secrets": [
        {
          "name": "ENGINE_SECRET_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:112233445566:secret:VantaEngineSecret-abc123"
        },
        {
          "name": "STRIPE_WEBHOOK_SECRET",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:112233445566:secret:StripeWebhookSecret-xyz789"
        },
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:112233445566:secret:PostgresProductionUrl-uvw456"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/vanta-coo-engine",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "production-core"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8000/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      }
    }
  ]
}
